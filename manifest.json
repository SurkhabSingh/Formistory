{
  "manifest_version": 3,
  "name": "Formistory",
  "version": "0.1.0",
  "description": "Keeps a private, local-only archive of the web forms you fill in, readable as documents.",
  "permissions": ["unlimitedStorage"],
  "background": {
    "service_worker": "src/background.js",
    "scripts": ["src/db.js", "src/background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "run_at": "document_idle",
      "js": ["src/field-identity.js", "src/redact.js", "src/collect.js", "src/capture.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Formistory",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "formistory@local",
      "strict_min_version": "115.0"
    }
  }
}
